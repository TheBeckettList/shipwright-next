        "cranks": "animation.shipwright.theran_skiff.cranks"
      },
      "scripts": {
        "pre_animation": [
          "v.furl = math.lerp(v.furl ?? 1.0, (math.mod(math.floor(q.property('shipwright:flags') / 2), 2)) ? 1.0 : 0.12, 0.08);",
          "v.fill = math.lerp(v.fill ?? 0.0, q.property('shipwright:sail_fill'), 0.1);",
          "v.trim = math.lerp(v.trim ?? 0.0, math.clamp(q.property('shipwright:wind_rel') * 0.5, -55, 55), 0.08);",
          "v.ftrim = math.lerp(v.ftrim ?? 0.0, (q.property('shipwright:wind_rel') >= 0 ? -1 : 1) * math.clamp((180 - math.abs(q.property('shipwright:wind_rel'))) * 0.45, 8, 80), 0.08);",
          "v.tt = math.lerp(v.tt ?? 0.0, q.property('shipwright:telltale'), 0.1);",
          "v.heel = math.lerp(v.heel ?? 0.0, q.property('shipwright:heel'), 0.1);",
          "v.row = math.lerp(v.row ?? 0.0, q.property('shipwright:rowing'), 0.15);",
          "v.l = math.lerp(v.l ?? 0.0, q.property('shipwright:stroke_l'), 0.12);",
          "v.r = math.lerp(v.r ?? 0.0, q.property('shipwright:stroke_r'), 0.12);",
          "v.turn = math.lerp(v.turn ?? 0.0, q.property('shipwright:turn'), 0.12);",
          "v.a = math.max(math.abs(v.l), math.abs(v.r));",
          "v.p_oar = math.mod((v.p_oar ?? 0) + q.delta_time * (266 + 240 * v.row), 360);",
          "v.p_pad = math.mod((v.p_pad ?? 0) + q.delta_time * (300 + 240 * v.row), 360);",
          "v.p_dp = math.mod((v.p_dp ?? 0) + q.delta_time * (260 + 240 * v.row), 360);",
          "v.p_scull = math.mod((v.p_scull ?? 0) + q.delta_time * (200 + 200 * v.row), 360);",
          "v.p_pole = math.mod((v.p_pole ?? 0) + q.delta_time * (120 + 120 * v.row), 360);",
          "v.p_crank = math.mod((v.p_crank ?? 0) + q.delta_time * 320 * v.row, 360);",
          "v.pw = (math.mod(math.floor(q.property('shipwright:flags') / 4), 2)) ? 1 : 0;",
          "v.po = v.pw > 0 ? v.p_crank : v.p_oar;"
        ],
        "animate": [
          "hull",
          {
            "rig": "(math.mod(math.floor(q.property('shipwright:flags') / 1), 2))"
          },
          {
            "oars": "(math.mod(math.floor(q.property('shipwright:kinds') / 32), 8)) == 0"
          },
          {
            "paddles": "(math.mod(math.floor(q.property('shipwright:kinds') / 32), 8)) > 0"
          },
          {
            "cranks": "((math.mod(math.floor(q.property('shipwright:kinds') / 256), 4)) > 0)"
          }
        ]
      },
